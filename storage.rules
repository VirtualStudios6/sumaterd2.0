rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin() { return request.auth != null && 'admin' in request.auth.token && request.auth.token.admin == true; }
    function validImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    match /articles/{articleId}/{allPaths=**} {
      allow read: if true;
      allow write: if admin() && validImage();
    }
    match /carousel/{panelId}/{allPaths=**} {
      allow read: if true;
      allow write: if admin() && validImage();
    }
    match /users/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid && validImage();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
