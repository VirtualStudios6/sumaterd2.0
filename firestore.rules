rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() {
      return signedIn() && (
        ('admin' in request.auth.token && request.auth.token.admin == true)
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }
    function published() { return resource.data.status == 'published'; }

    match /articles/{articleId} {
      allow get, list: if published() || admin();
      allow create, update, delete: if admin();
    }
    match /carousel/{panelId} {
      allow get, list: if resource.data.active == true || admin();
      allow create, update, delete: if admin();
    }
    match /categories/{categoryId} {
      allow read: if resource.data.active == true || admin();
      allow write: if admin();
    }
    match /settings/{settingId} {
      allow read: if resource.data.public == true || admin();
      allow write: if admin();
    }
    match /users/{uid} {
      allow read: if owns(uid) || admin();
      allow create: if owns(uid)
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.keys().hasOnly([
          'uid', 'fullName', 'email', 'cedulaMasked', 'status', 'authProvider',
          'phone', 'province', 'municipality', 'bio', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'fullName', 'email', 'cedulaMasked', 'status', 'authProvider',
          'phone', 'province', 'municipality', 'bio', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 3
        && request.resource.data.fullName.size() <= 100
        && request.resource.data.cedulaMasked == 'No registrada (Google)'
        && request.resource.data.status == 'active'
        && request.resource.data.authProvider == 'google.com'
        && request.resource.data.phone == ''
        && request.resource.data.province == ''
        && request.resource.data.municipality == ''
        && request.resource.data.bio == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if owns(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'phone', 'province', 'municipality', 'bio', 'updatedAt'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 3
        && request.resource.data.fullName.size() <= 100
        && (!request.resource.data.keys().hasAny(['phone'])
          || (request.resource.data.phone is string && request.resource.data.phone.size() <= 24))
        && (!request.resource.data.keys().hasAny(['province'])
          || (request.resource.data.province is string && request.resource.data.province.size() <= 60))
        && (!request.resource.data.keys().hasAny(['municipality'])
          || (request.resource.data.municipality is string && request.resource.data.municipality.size() <= 80))
        && (!request.resource.data.keys().hasAny(['bio'])
          || (request.resource.data.bio is string && request.resource.data.bio.size() <= 280));
      allow delete: if false;
    }
    match /cedulaReservations/{id} { allow read, write: if false; }
    match /userPrivate/{uid} { allow read, write: if false; }
    match /changeInterests/{id} { allow read, write: if false; }
    match /forumPosts/{postId} {
      allow get, list: if resource.data.status == 'published';
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'title', 'content', 'topic', 'authorId', 'authorName', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 2
        && request.resource.data.authorName.size() <= 80
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.title.size() <= 100
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 10
        && request.resource.data.content.size() <= 1000
        && request.resource.data.topic in ['comunidad', 'pais', 'educacion', 'juventud', 'accesibilidad']
        && request.resource.data.status == 'published'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update, delete: if admin();

      match /forumReplies/{replyId} {
        allow get, list: if resource.data.status == 'published';
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly([
            'content', 'authorId', 'authorName', 'status', 'createdAt'
          ])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() >= 2
          && request.resource.data.authorName.size() <= 80
          && request.resource.data.content is string
          && request.resource.data.content.size() >= 2
          && request.resource.data.content.size() <= 600
          && request.resource.data.status == 'published'
          && request.resource.data.createdAt == request.time;
        allow update, delete: if admin();
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
